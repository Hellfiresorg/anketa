# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://voice_survey:STRONG_PASSWORD@localhost:5432/voice_survey

# ─────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
#  JWT   (generate with: openssl rand -hex 32)
# ─────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────
#  Groq transcription
# ─────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ─────────────────────────────────────────────
#  Audio storage
# ─────────────────────────────────────────────
AUDIO_ROOT=/var/anketa/audio
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SEC=300
DISK_SPACE_MIN_BYTES=1073741824

# ─────────────────────────────────────────────
#  CORS  (comma-separated; include ALL frontend origins)
#  Example: your client subdomain + admin subdomain on SpaceWeb
# ─────────────────────────────────────────────
CORS_ORIGINS=https://anketa.yourdomain.ru,https://admin.yourdomain.ru

# ─────────────────────────────────────────────
#  Frontend URL  (used to build invitation links sent to clients)
#  Must point to the CLIENT frontend, not the admin panel
# ─────────────────────────────────────────────
FRONTEND_URL=https://anketa.yourdomain.ru

# ─────────────────────────────────────────────
#  App
# ─────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ─────────────────────────────────────────────
#  Sentry (optional — leave empty to disable)
# ─────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────
#  First-run seed  (comma-separated email:password:full_name)
#  Remove or empty out after first run
# ─────────────────────────────────────────────
SEED_MANAGERS=admin@yourdomain.ru:STRONG_PASSWORD:Администратор
